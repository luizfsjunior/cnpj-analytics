# Copie para .env e ajuste se necessário.
# Dentro do docker compose use host "postgres"; do host use "localhost".
DATABASE_URL=postgres://cnpj:cnpj@localhost:5433/cnpj?sslmode=disable
PORT=8001

# --- Tuning da carga (analytics/load.sh) ------------------------------------
# Opcionais. O load.sh lê este .env automaticamente; valores passados na linha
# de comando (ex.: TUNE_RAM_GB=32 bash analytics/load.sh) têm prioridade.
# TUNE=1                  # 1 = aplica tuning de carga (default) | 0 = desliga
# ORCAMENTO_RAM_MB=3072   # teto de RAM da carga (default: 3072). TUDO é derivado daqui.
# ORCAMENTO_VCPU=4        # vCPU que a carga pode ocupar (default: min(4, nproc))
# LOAD_JOBS=3            # blocos paralelos na Fase 3 (default: derivado, teto 3)
# IDX_JOBS=3             # índices simultâneos na Fase 4 (default: = LOAD_JOBS)
# CARGA_TRANSFORM=blocos  # `sequencial` volta ao transform uma-tabela-por-vez
# REJEITO_LIMIAR_PCT=0.1  # acima disto a carga AVISA (nunca aborta)
# CONTAR_DUP_SOCIO=0      # conta duplicatas idênticas em socio (caro; ver spec 5.2)
# TUNE_RAM_GB=6           # nome antigo do orçamento, em GB; ainda funciona
# MAX_PARALLEL_MAINT=4    # workers paralelos p/ criação de índices (default: 4)
# Sobrescrevem o cálculo automático (normalmente desnecessário):
# MAINT_WORK_MEM=737MB
# WORK_MEM=92MB
# MAX_WAL_SIZE=3GB

# --- Caminho dos dados no HOST (docker compose) ------------------------------
# Onde ficam os zips da Receita e o PGDATA. Local pode ficar comentado (default
# ./data). No servidor aponta para fora da árvore de deploy, senão o rsync do
# CI/CD passaria por cima dos ~72 GB.
# CNPJ_HOST_DATA_DIR=/opt/applications/cnpj-analytics/data
